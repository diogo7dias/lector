#!/usr/bin/env bash
# Pre-commit hook: fail if staged C/C++ files are not clang-format clean.
# Checks the staged content only, with the same clang-format 21 and exclusions
# as bin/clang-format-fix and CI. It never rewrites or re-stages files.
# Install with ./bin/install-git-hooks. Skip once with `git commit --no-verify`.
set -euo pipefail

if command -v clang-format-21 >/dev/null 2>&1; then
  CF=clang-format-21
elif command -v clang-format >/dev/null 2>&1; then
  CF=clang-format
else
  echo "pre-commit: clang-format not found; install clang-format-21 (CI uses 21)." >&2
  exit 1
fi
major="$("$CF" --version | grep -oE '[0-9]+' | head -n1)"
if [[ -z "$major" || "$major" -lt 21 ]]; then
  echo "pre-commit: $CF is too old ($("$CF" --version)); CI uses clang-format 21." >&2
  exit 1
fi

bad=()
while IFS= read -r -d '' f; do
  case "$f" in
    lib/EpdFont/builtinFonts/*|lib/uzlib/*|lib/miniz/third_party/*) continue ;;
  esac
  if ! git show ":$f" | "$CF" -style=file --assume-filename="$f" --dry-run --Werror >/dev/null 2>&1; then
    bad+=("$f")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.c' '*.cpp' '*.h' '*.hpp')

if (( ${#bad[@]} )); then
  echo "pre-commit: these staged files need clang-format:" >&2
  printf '  %s\n' "${bad[@]}" >&2
  echo "Run ./bin/clang-format-fix -g, re-stage, and commit again." >&2
  exit 1
fi
