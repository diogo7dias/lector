             sTemp[i] = p[cZigZag[i]];
         memcpy(&pJPEG->sQuantTable[iTableOffset], sTemp, DCTSIZE*sizeof(short)); // copy back to original spot
         
+        for (i=0; i<DCTSIZE; i++)
+        {
+            const int iScaled = (uint16_t)sTemp[i] * iScaleBits[i];
+            if (iScaled > iMax) iMax = iScaled;
+        }
+    }
+    // The prescaled quantizers carry 2 fraction bits, so with the small quantizers of a
+    // high-quality file (1-2) the high-frequency ones truncate by up to 100%. The C column
+    // pass keeps up to 4 more and shifts them out after the multiply, as long as every entry
+    // still fits in 16 bits. The SIMD column passes multiply 16-bit lanes, so they keep 2.
+    pJPEG->ucQuantShift = 0;
+#if !defined(HAS_SSE) && !defined(HAS_NEON)
+    while (pJPEG->ucQuantShift < 4 && (iMax >> (11 - pJPEG->ucQuantShift)) <= 32767)
+        pJPEG->ucQuantShift++;
+#endif
+    for (iTable=0; iTable<pJPEG->ucNumComponents; iTable++)
+    {
         // Prescale for DCT multiplication
-        p = (uint16_t *)&pJPEG->sQuantTable[iTableOffset];
+        p = (uint16_t *)&pJPEG->sQuantTable[iTable * DCTSIZE];
         for (i=0; i<DCTSIZE; i++)
         {
-            p[i] = (uint16_t)((p[i] * iScaleBits[i]) >> 12);
+            p[i] = (uint16_t)((p[i] * iScaleBits[i]) >> (12 - pJPEG->ucQuantShift));
         }
     }
 } /* JPEGFixQuantD() */
