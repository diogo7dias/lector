Subject: [PATCH] Reject chunks that run past the end of the file

The chunk length check measured from the buffer start rather than the chunk,
so an IDAT cut short by the end of the file passed it, and the IDAT loop then
spun forever on 0-byte reads. A failed read now ends the decode too.

---
diff --git a/src/png.inl b/src/png.inl
--- a/src/png.inl
+++ b/src/png.inl
@@ -825,7 +825,11 @@
         }
 
         iLen = MOTOLONG(&s[iOffset]); // chunk length
-        if (iLen < 0 || iLen + (iFileOffset - iBytesRead) > pPage->PNGFile.iSize) // invalid data
+        // Lector patch: the chunk's data ends 8 header bytes past its own offset in the
+        // buffer, not at the buffer start; an IDAT cut short by the end of the file
+        // otherwise passes and the read loop below spins on 0-byte reads forever.
+        // (subtracted, as a length near INT_MAX would overflow the sum)
+        if (iLen < 0 || iLen > pPage->PNGFile.iSize - (iFileOffset - iBytesRead) - iOffset - 8) // invalid data
         {
             pPage->iError = PNG_DECODE_ERROR;
             return 1;
@@ -889,6 +893,10 @@
                     if (iOffset >= iBytesRead) {
                         // we ran out of data; get some more
                         iBytesRead = (*pPage->pfnRead)(&pPage->PNGFile, pPage->ucFileBuf, (iLen > PNG_FILE_BUF_SIZE) ? PNG_FILE_BUF_SIZE : iLen);
+                        if (iBytesRead <= 0) { // Lector patch: a failed read ends the decode
+                            pPage->iError = PNG_DECODE_ERROR;
+                            return 1;
+                        }
                         iFileOffset += iBytesRead;
                         iOffset = 0;
                     } else {
