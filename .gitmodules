[submodule "freeink-sdk"]
	path = freeink-sdk
	# Diogo's fork, not Free-Ink/freeink-sdk. The fork carries lector-only X3 panel
	# timing work that upstream has no reason to take. It tracks upstream otherwise:
	# fetch Free-Ink as a second remote inside the submodule and merge into the lector
	# branch when syncing.
	url = https://github.com/diogo7dias/freeink-sdk.git
	# The X4 Pro line: lector/x4pro-sdk-merged, the fork's X4 Pro work with Free-Ink
	# main merged in (UC8179 driver, UC8279 grayscale plane inversion fix).
	branch = lector/x4pro-sdk-merged
