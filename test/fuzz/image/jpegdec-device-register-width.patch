Host test builds only: build JPEGDEC the way the ESP32-C3 and S3 run it.
- Keep the 32-bit bit reader. JPEGDEC picks a 64-bit one on x86-64, and its progressive
  decoder hard-codes 32-bit shifts.
- Read words byte by byte. JPEGDEC.h includes Arduino.h only off ESP_PLATFORM, so
  HAL_ESP32_HAL_H_ is never set and the device never defines ALLOWS_UNALIGNED (the C3
  JPEGParseInfo has no lhu); x86-64 defines it, and its word loads at byte offsets are
  undefined behaviour that UBSan reports.

diff --git a/src/JPEGDEC.h b/src/JPEGDEC.h
--- a/src/JPEGDEC.h
+++ b/src/JPEGDEC.h
@@ -35,7 +35,7 @@
 #define __builtin_bswap32 _byteswap_ulong
 #endif
 // Cortex-M4/M7 allow unaligned access to SRAM
-#if defined(HAL_ESP32_HAL_H_) || defined(TEENSYDUINO) || defined(ARM_MATH_CM4) || defined(ARM_MATH_CM7) || defined (__x86_64__) || defined(TEENSYDUINO)
+#if (defined(HAL_ESP32_HAL_H_) || defined(TEENSYDUINO) || defined(ARM_MATH_CM4) || defined(ARM_MATH_CM7) || defined (__x86_64__) || defined(TEENSYDUINO)) && !defined(LECTOR_DEVICE_REGISTER_WIDTH)
 #define ALLOWS_UNALIGNED
 #endif
 
@@ -81,7 +81,7 @@
 #define MCU4 (DCTSIZE * 4)
 #define MCU5 (DCTSIZE * 5)
 
-#if defined(__arm64__) || defined(__aarch64__) || defined (__x86_64__)
+#if (defined(__arm64__) || defined(__aarch64__) || defined (__x86_64__)) && !defined(LECTOR_DEVICE_REGISTER_WIDTH)
 #define REGISTER_WIDTH 64
 typedef uint64_t my_ulong;
 typedef int64_t my_long;
