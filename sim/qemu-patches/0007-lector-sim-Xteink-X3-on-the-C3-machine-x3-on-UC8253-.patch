index a3d86cf..5901f16 100644
--- a/hw/riscv/esp32c3.c
+++ b/hw/riscv/esp32c3.c
@@ -36,6 +36,7 @@
 #include "hw/nvram/esp32c3_efuse.h"
 #include "hw/riscv/esp32c3_clk.h"
 #include "hw/riscv/esp32c3_intmatrix.h"
+#include "hw/i2c/esp32_i2c.h"
 #include "hw/misc/esp32c3_sha.h"
 #include "hw/timer/esp32c3_timg.h"
 #include "hw/timer/esp32c3_systimer.h"
@@ -75,6 +76,7 @@ struct Esp32C3MachineState {
     qemu_irq cpu_reset;
 
     DeviceState *eth; /* Ethernet controller */
+    bool x3;          /* lector simulator: Xteink X3 board instead of the X4 */
     ESP32C3IntMatrixState intmatrix;
     ESP32C3UARTState uart[ESP32C3_UART_COUNT];
     ESP32C3GPIOState gpio;
@@ -617,8 +619,9 @@ static void esp32c3_machine_init(MachineState *machine)
         sysbus_connect_irq(SYS_BUS_DEVICE(&ms->spi2), 0,
                            qdev_get_gpio_in(intmatrix_dev, ETS_SPI2_INTR_SOURCE));
 
+        /* The X3 has a UC8253 (BUSY low = busy) on the same pins. */
         DeviceState *gpio = DEVICE(&ms->gpio);
-        DeviceState *panel = qdev_new("ssd1677");
+        DeviceState *panel = qdev_new(ms->x3 ? "uc8253" : "ssd1677");
         object_property_add_child(OBJECT(machine), "panel", OBJECT(panel));
         qdev_realize_and_unref(panel, BUS(ms->spi2.spi), &error_fatal);
         qdev_connect_gpio_out_named(gpio, "pin-out", 21, qdev_get_gpio_in_named(panel, SSI_GPIO_CS, 0));
@@ -636,6 +639,34 @@ static void esp32c3_machine_init(MachineState *machine)
         qdev_realize_and_unref(card, qdev_get_child_bus(sd, "sd-bus"), &error_fatal);
     }
 
+    /* lector simulator: I2C0. The X3 fingerprints itself by its chips on it
+     * (XteinkDetect.cpp): BQ27220 gauge 0x55 (80 %, 3.9 V, -50 mA: no USB),
+     * DS3231 clock 0x68 (2026-10-05 12:00:00, OSF clear), QMI8658 IMU 0x6B.
+     * The X4 has none, so every probe NACKs there. */
+    {
+        DeviceState *i2c = qdev_new(TYPE_ESP32_I2C);
+        object_property_add_child(OBJECT(machine), "i2c0", OBJECT(i2c));
+        qdev_prop_set_uint32(i2c, "cmd-count", 8);
+        qdev_prop_set_bit(i2c, "c3-opcodes", true);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(i2c), &error_fatal);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_I2C_EXT_BASE,
+                                            sysbus_mmio_get_region(SYS_BUS_DEVICE(i2c), 0), 0);
+        sysbus_connect_irq(SYS_BUS_DEVICE(i2c), 0, qdev_get_gpio_in(intmatrix_dev, ETS_I2C_EXT0_INTR_SOURCE));
+        if (ms->x3) {
+            I2CBus *bus = I2C_BUS(qdev_get_child_bus(i2c, "i2c"));
+            static const struct { uint8_t addr; const char *init; } chips[] = {
+                { 0x55, "2c:5000,08:3c0f,0c:ceff" },
+                { 0x68, "0:00001201051026,e:1c08" },
+                { 0x6B, "0:05" },
+            };
+            for (int i = 0; i < ARRAY_SIZE(chips); i++) {
+                I2CSlave *chip = i2c_slave_new("i2c-regs", chips[i].addr);
+                qdev_prop_set_string(DEVICE(chip), "init", chips[i].init);
+                i2c_slave_realize_and_unref(chip, bus, &error_fatal);
+            }
+        }
+    }
+
     /* SHA realization */
     {
         ms->sha.parent.gdma = ESP_GDMA(&ms->gdma);
@@ -713,6 +744,16 @@ static void esp32c3_machine_init(MachineState *machine)
 
 
 /* Initialize machine type */
+static bool esp32c3_get_x3(Object *obj, Error **errp)
+{
+    return ESP32C3_MACHINE(obj)->x3;
+}
+
+static void esp32c3_set_x3(Object *obj, bool value, Error **errp)
+{
+    ESP32C3_MACHINE(obj)->x3 = value;
+}
+
 static void esp32c3_machine_class_init(ObjectClass *oc, void *data)
 {
     MachineClass *mc = MACHINE_CLASS(oc);
@@ -723,6 +764,8 @@ static void esp32c3_machine_class_init(ObjectClass *oc, void *data)
     mc->default_cpus = 1;
     // 0x4f600
     mc->default_ram_size = 400 * 1024;
+    object_class_property_add_bool(oc, "x3", esp32c3_get_x3, esp32c3_set_x3);
+    object_class_property_set_description(oc, "x3", "Xteink X3 board: UC8253 panel, I2C gauge, clock and IMU");
 }
 
 /* Create a new type of machine ("child class") */
