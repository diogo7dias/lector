index 0000000..793a6f4
--- /dev/null
+++ b/hw/display/uc8253.c
@@ -0,0 +1,262 @@
+/*
+ * UC8253 e-paper controller (792x528, as on the Xteink X3), for the lector
+ * simulator.
+ *
+ * Commands arrive on SPI with D/C low, data with D/C high. DTM1 (0x10) and
+ * DTM2 (0x13) fill the old and new planes gate row by gate row (gate 0 first,
+ * which is the bottom of the logical frame), MSB = leftmost pixel, 1 = white;
+ * inside a partial window (0x91 PTIN + 0x90 PTL) they fill only the window.
+ * PON (0x04), DRF (0x12) and POF (0x02) pull BUSY low (busy) for a while; when
+ * the refresh ends the panel shows the new plane: written as a PGM to "image"
+ * and counted in "frames".
+ *
+ * Not modelled: LUTs, waveforms, the look of grayscale passes.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/ssi.h"
+#include "qapi/visitor.h"
+
+#define TYPE_UC8253 "uc8253"
+OBJECT_DECLARE_SIMPLE_TYPE(Uc8253State, UC8253)
+
+#define W 792
+#define H 528
+#define ROW (W / 8)
+
+struct Uc8253State {
+    SSIPeripheral parent_obj;
+    qemu_irq busy;
+    QEMUTimer *busy_timer;
+
+    bool dc;
+    bool asleep;
+    bool partial;
+    bool refreshing;
+    uint8_t cmd;
+    uint32_t nparam;
+    uint8_t params[16];
+    int xs, xe, ys, ye;     /* window: x in bytes, y in gates */
+    int x, y;               /* write position */
+
+    uint8_t old[H][ROW];    /* indexed by gate */
+    uint8_t new[H][ROW];
+    uint8_t screen[H][W];   /* logical rows: 0 black .. 255 white */
+
+    char *image;
+    uint32_t frames;
+    uint32_t refresh_ms, power_ms;
+};
+
+static void uc8253_write_image(Uc8253State *s)
+{
+    if (!s->image) {
+        return;
+    }
+    g_autofree char *tmp = g_strdup_printf("%s.tmp", s->image);
+    FILE *f = fopen(tmp, "wb");
+    if (!f) {
+        return;
+    }
+    fprintf(f, "P5\n%d %d\n255\n", W, H);
+    fwrite(s->screen, 1, sizeof(s->screen), f);
+    fclose(f);
+    rename(tmp, s->image);
+}
+
+static void uc8253_idle(void *opaque)
+{
+    Uc8253State *s = opaque;
+    if (s->refreshing) {
+        s->refreshing = false;
+        for (int gate = 0; gate < H; gate++) {
+            for (int x = 0; x < W; x++) {
+                const int white = (s->new[gate][x / 8] >> (7 - (x & 7))) & 1;
+                s->screen[H - 1 - gate][x] = white ? 0xFF : 0x00;
+            }
+        }
+        s->frames++;
+        uc8253_write_image(s);
+    }
+    qemu_set_irq(s->busy, 1);
+}
+
+static void uc8253_busy_for(Uc8253State *s, uint32_t ms)
+{
+    qemu_set_irq(s->busy, 0);
+    timer_mod(s->busy_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + ms);
+}
+
+static void uc8253_window_all(Uc8253State *s)
+{
+    s->xs = 0; s->xe = ROW - 1;
+    s->ys = 0; s->ye = H - 1;
+}
+
+static void uc8253_data(Uc8253State *s, uint8_t plane[H][ROW], uint8_t v)
+{
+    if (s->y > s->ye) {
+        return;
+    }
+    plane[s->y][s->x] = v;
+    if (++s->x > s->xe) {
+        s->x = s->xs;
+        s->y++;
+    }
+}
+
+static void uc8253_param(Uc8253State *s, uint8_t v)
+{
+    const uint32_t n = s->nparam++;
+    if (n < sizeof(s->params)) {
+        s->params[n] = v;
+    }
+    const uint8_t *p = s->params;
+    switch (s->cmd) {
+    case 0x10:
+        uc8253_data(s, s->old, v);
+        break;
+    case 0x13:
+        uc8253_data(s, s->new, v);
+        break;
+    case 0x90:
+        if (n == 7) {
+            s->xs = ((p[0] << 8) | p[1]) / 8;
+            s->xe = ((p[2] << 8) | p[3]) / 8;
+            s->ys = (p[4] << 8) | p[5];
+            s->ye = (p[6] << 8) | p[7];
+            s->xs = MIN(s->xs, ROW - 1); s->xe = MIN(s->xe, ROW - 1);
+            s->ys = MIN(s->ys, H - 1);   s->ye = MIN(s->ye, H - 1);
+        }
+        break;
+    case 0x07:
+        if (v == 0xA5) {
+            s->asleep = true;
+        }
+        break;
+    }
+}
+
+static void uc8253_command(Uc8253State *s, uint8_t c)
+{
+    s->cmd = c;
+    s->nparam = 0;
+    switch (c) {
+    case 0x10:
+    case 0x13:
+        if (!s->partial) {
+            uc8253_window_all(s);
+        }
+        s->x = s->xs;
+        s->y = s->ys;
+        break;
+    case 0x91:
+        s->partial = true;
+        break;
+    case 0x92:
+        s->partial = false;
+        uc8253_window_all(s);
+        break;
+    case 0x04:
+    case 0x02:
+        uc8253_busy_for(s, s->power_ms);
+        break;
+    case 0x12:
+        s->refreshing = true;
+        uc8253_busy_for(s, s->refresh_ms);
+        break;
+    }
+}
+
+static uint32_t uc8253_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    Uc8253State *s = UC8253(dev);
+    if (s->asleep) {
+        return 0;
+    }
+    if (s->dc) {
+        uc8253_param(s, val);
+    } else {
+        uc8253_command(s, val);
+    }
+    return 0;
+}
+
+static void uc8253_dc(void *opaque, int n, int level)
+{
+    UC8253(opaque)->dc = level;
+}
+
+static void uc8253_rst(void *opaque, int n, int level)
+{
+    Uc8253State *s = UC8253(opaque);
+    if (!level) {
+        /* Reset wakes the chip and keeps the RAM. */
+        s->asleep = false;
+        s->partial = false;
+        s->refreshing = false;
+        uc8253_window_all(s);
+        timer_del(s->busy_timer);
+        qemu_set_irq(s->busy, 1);
+    }
+}
+
+static void uc8253_realize(SSIPeripheral *dev, Error **errp)
+{
+    Uc8253State *s = UC8253(dev);
+    s->busy_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, uc8253_idle, s);
+    qdev_init_gpio_in_named(DEVICE(dev), uc8253_dc, "dc", 1);
+    qdev_init_gpio_in_named(DEVICE(dev), uc8253_rst, "rst", 1);
+    qdev_init_gpio_out_named(DEVICE(dev), &s->busy, "busy", 1);
+    memset(s->old, 0xFF, sizeof(s->old));
+    memset(s->new, 0xFF, sizeof(s->new));
+    memset(s->screen, 0xFF, sizeof(s->screen));
+    uc8253_window_all(s);
+}
+
+static Property uc8253_properties[] = {
+    DEFINE_PROP_STRING("image", Uc8253State, image),
+    /* Roughly what the X3 panel takes for a refresh and a power switch. */
+    DEFINE_PROP_UINT32("refresh-ms", Uc8253State, refresh_ms, 450),
+    DEFINE_PROP_UINT32("power-ms", Uc8253State, power_ms, 20),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void uc8253_frames_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &UC8253(obj)->frames, errp);
+}
+
+static void uc8253_init(Object *obj)
+{
+    object_property_add(obj, "frames", "uint32", uc8253_frames_get, NULL, NULL, NULL);
+}
+
+static void uc8253_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+    k->realize = uc8253_realize;
+    k->transfer = uc8253_transfer;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_props(dc, uc8253_properties);
+}
+
+static const TypeInfo uc8253_info = {
+    .name = TYPE_UC8253,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(Uc8253State),
+    .instance_init = uc8253_init,
+    .class_init = uc8253_class_init,
+};
+
+static void uc8253_register_types(void)
+{
+    type_register_static(&uc8253_info);
+}
+
+type_init(uc8253_register_types)
