diff --git a/include/hw/misc/esp32c3_saradc.h b/include/hw/misc/esp32c3_saradc.h
new file mode 100644
index 0000000..8bae96c
--- /dev/null
+++ b/include/hw/misc/esp32c3_saradc.h
@@ -0,0 +1,20 @@
+/*
+ * ESP32-C3 SAR ADC (one-shot mode only), for the lector simulator.
+ * Each channel's raw 12-bit reading is a QOM property ("ch0".."ch4" for ADC1,
+ * "ch5" for ADC2 channel 0), so a test sets a voltage with qom-set.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+
+#define TYPE_ESP32C3_SARADC "esp32c3.saradc"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32C3SarAdcState, ESP32C3_SARADC)
+
+#define ESP32C3_SARADC_CHANNELS 6
+
+struct ESP32C3SarAdcState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t regs[0x100 / 4];
+    uint32_t raw[ESP32C3_SARADC_CHANNELS];
+};
