 hw/misc/meson.build              |   3 +-
 hw/riscv/esp32c3.c               |  10 +++
 include/hw/misc/esp32c3_saradc.h |  20 ++++++
 4 files changed, 135 insertions(+), 1 deletion(-)
 create mode 100644 hw/misc/esp32c3_saradc.c
 create mode 100644 include/hw/misc/esp32c3_saradc.h

diff --git a/hw/misc/esp32c3_saradc.c b/hw/misc/esp32c3_saradc.c
new file mode 100644
index 0000000..c05b637
--- /dev/null
+++ b/hw/misc/esp32c3_saradc.c
@@ -0,0 +1,103 @@
+/*
+ * ESP32-C3 SAR ADC (one-shot mode only), for the lector simulator.
+ *
+ * A conversion completes the moment ONETIME_START is set: the result lands in
+ * the data status register and the done bit rises in INT_RAW. Continuous
+ * (DMA) mode is not modelled.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "hw/misc/esp32c3_saradc.h"
+
+#define A_ONETIME_SAMPLE 0x020
+#define A_ADC1_DATA      0x02C
+#define A_ADC2_DATA      0x030
+#define A_INT_RAW        0x044
+#define A_INT_CLR        0x04C
+
+#define ONETIME_ADC1     BIT(31)
+#define ONETIME_ADC2     BIT(30)
+#define ONETIME_START    BIT(29)
+#define ONETIME_CHANNEL(v) (((v) >> 25) & 0xF)
+#define ADC1_DONE        BIT(31)
+#define ADC2_DONE        BIT(30)
+
+static uint64_t esp32c3_saradc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32C3SarAdcState *s = ESP32C3_SARADC(opaque);
+    return s->regs[addr / 4];
+}
+
+static void esp32c3_saradc_convert(ESP32C3SarAdcState *s, uint32_t sample)
+{
+    const unsigned ch = ONETIME_CHANNEL(sample);
+    if (sample & ONETIME_ADC1) {
+        s->regs[A_ADC1_DATA / 4] = ch < 5 ? (s->raw[ch] & 0xFFF) : 0;
+        s->regs[A_INT_RAW / 4] |= ADC1_DONE;
+    }
+    if (sample & ONETIME_ADC2) {
+        s->regs[A_ADC2_DATA / 4] = s->raw[5] & 0xFFF;
+        s->regs[A_INT_RAW / 4] |= ADC2_DONE;
+    }
+}
+
+static void esp32c3_saradc_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ESP32C3SarAdcState *s = ESP32C3_SARADC(opaque);
+    switch (addr) {
+    case A_INT_CLR:
+        s->regs[A_INT_RAW / 4] &= ~value;
+        return;
+    case A_ONETIME_SAMPLE:
+        if ((value & ONETIME_START) && !(s->regs[addr / 4] & ONETIME_START)) {
+            esp32c3_saradc_convert(s, value);
+        }
+        break;
+    case A_ADC1_DATA:
+    case A_ADC2_DATA:
+    case A_INT_RAW:
+        return;
+    }
+    s->regs[addr / 4] = value;
+}
+
+static const MemoryRegionOps esp32c3_saradc_ops = {
+    .read = esp32c3_saradc_read,
+    .write = esp32c3_saradc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void esp32c3_saradc_init(Object *obj)
+{
+    ESP32C3SarAdcState *s = ESP32C3_SARADC(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32c3_saradc_ops, s, TYPE_ESP32C3_SARADC, 0x100);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    /* Plain object properties, not qdev ones: the harness changes them at run time. */
+    for (int i = 0; i < ESP32C3_SARADC_CHANNELS; i++) {
+        g_autofree char *name = g_strdup_printf("ch%d", i);
+        s->raw[i] = 4095;
+        object_property_add_uint32_ptr(obj, name, &s->raw[i], OBJ_PROP_FLAG_READWRITE);
+    }
+}
+
+static void esp32c3_saradc_class_init(ObjectClass *klass, void *data)
+{
+}
+
+static const TypeInfo esp32c3_saradc_info = {
+    .name = TYPE_ESP32C3_SARADC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32C3SarAdcState),
+    .instance_init = esp32c3_saradc_init,
+    .class_init = esp32c3_saradc_class_init,
+};
+
+static void esp32c3_saradc_register_types(void)
+{
+    type_register_static(&esp32c3_saradc_info);
+}
+
+type_init(esp32c3_saradc_register_types)
