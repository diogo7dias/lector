+/* lector simulator: jump QEMU_CLOCK_VIRTUAL forward, for a device that models
+ * the whole chip asleep until its next event. Caller holds the BQL. */
+void icount_advance(int64_t ns)
+{
+    seqlock_write_lock(&timers_state.vm_clock_seqlock, &timers_state.vm_clock_lock);
+    qatomic_set_i64(&timers_state.qemu_icount_bias, timers_state.qemu_icount_bias + ns);
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock, &timers_state.vm_clock_lock);
+}
+
 void icount_start_warp_timer(void)
 {
     int64_t clock;
