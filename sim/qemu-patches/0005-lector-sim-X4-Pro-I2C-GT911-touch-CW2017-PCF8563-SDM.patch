@@ -64,6 +64,19 @@ static uint64_t esp32c3_gpio_in(ESP32C3GPIOState *s)
     return ((ext & ~s->enable) | (s->out & s->enable)) & PIN_MASK(s);
 }
 
+/* Light-sleep GPIO wake: a pin with WAKEUP_ENABLE whose level-type interrupt
+ * (4 = low, 5 = high) matches the pin now. */
+bool esp32c3_gpio_wake_pending(ESP32C3GPIOState *s)
+{
+    for (int i = 0; i < s->npins; i++) {
+        const uint32_t type = PIN_INT_TYPE(s->pin[i]);
+        if ((s->pin[i] & BIT(10)) && (type == 4 || type == 5) && esp32c3_gpio_level(s, i) == (type == 5)) {
+            return true;
+        }
+    }
+    return false;
+}
+
 bool esp32c3_gpio_level(ESP32C3GPIOState *s, int pin)
 {
     return (esp32c3_gpio_in(s) >> pin) & 1;
