diff --git a/hw/misc/lector_i2c.c b/hw/misc/lector_i2c.c
new file mode 100644
index 0000000..0208ba4
--- /dev/null
+++ b/hw/misc/lector_i2c.c
@@ -0,0 +1,221 @@
+/*
+ * lector simulator: the I2C chips on the Xteink boards.
+ *
+ * "i2c-regs" is a plain register file with an 8-bit auto-incrementing pointer,
+ * enough for the chips the firmware only reads and configures: the CW2017 and
+ * BQ27220 gauges, the PCF8563 and DS3231 clocks, the QMI8658 IMU. "init" seeds
+ * it as "reg:hexbytes" pairs, e.g. "0:0d,4:50".
+ *
+ * "gt911" is the touch controller: a 16-bit pointer, status at 0x814E and
+ * 8-byte contact records at 0x8150. Touch comes from QOM: set "x"/"y" (raw
+ * controller units), then "down" true or false; "home" holds the capacitive key.
+ * While a finger is down every status clear produces a fresh frame, like the
+ * chip's report rate; a lift produces one empty frame.
+ */
+#include "qemu/osdep.h"
+#include "qemu/cutils.h"
+#include "qapi/error.h"
+#include "hw/i2c/i2c.h"
+#include "hw/qdev-properties.h"
+#include "qom/object.h"
+
+#define TYPE_I2C_REGS "i2c-regs"
+OBJECT_DECLARE_SIMPLE_TYPE(I2CRegsState, I2C_REGS)
+
+struct I2CRegsState {
+    I2CSlave parent_obj;
+    uint8_t regs[256];
+    uint8_t ptr;
+    bool ptr_set;
+    char *init;
+};
+
+static int i2c_regs_event(I2CSlave *i2c, enum i2c_event event)
+{
+    I2CRegsState *s = I2C_REGS(i2c);
+    if (event == I2C_START_SEND) {
+        s->ptr_set = false;
+    }
+    return 0;
+}
+
+static uint8_t i2c_regs_recv(I2CSlave *i2c)
+{
+    I2CRegsState *s = I2C_REGS(i2c);
+    return s->regs[s->ptr++];
+}
+
+static int i2c_regs_send(I2CSlave *i2c, uint8_t data)
+{
+    I2CRegsState *s = I2C_REGS(i2c);
+    if (!s->ptr_set) {
+        s->ptr = data;
+        s->ptr_set = true;
+    } else {
+        s->regs[s->ptr++] = data;
+    }
+    return 0;
+}
+
+static void i2c_regs_realize(DeviceState *dev, Error **errp)
+{
+    I2CRegsState *s = I2C_REGS(dev);
+    const char *p = s->init ? s->init : "";
+    while (*p) {
+        unsigned long reg;
+        const char *end;
+        if (qemu_strtoul(p, &end, 16, &reg) || *end != ':' || reg > 0xFF) {
+            error_setg(errp, "i2c-regs: bad init near \"%s\"", p);
+            return;
+        }
+        for (p = end + 1; g_ascii_isxdigit(p[0]) && g_ascii_isxdigit(p[1]); p += 2) {
+            char byte[3] = { p[0], p[1], 0 };
+            s->regs[reg++ & 0xFF] = strtoul(byte, NULL, 16);
+        }
+        if (*p == ',') {
+            p++;
+        } else if (*p) {
+            error_setg(errp, "i2c-regs: bad init near \"%s\"", p);
+            return;
+        }
+    }
+}
+
+static Property i2c_regs_properties[] = {
+    DEFINE_PROP_STRING("init", I2CRegsState, init),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void i2c_regs_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    dc->realize = i2c_regs_realize;
+    device_class_set_props(dc, i2c_regs_properties);
+    k->event = i2c_regs_event;
+    k->recv = i2c_regs_recv;
+    k->send = i2c_regs_send;
+}
+
+#define TYPE_GT911 "gt911"
+OBJECT_DECLARE_SIMPLE_TYPE(GT911State, GT911)
+
+#define GT911_STATUS 0x814E
+#define GT911_POINTS 0x8150
+
+struct GT911State {
+    I2CSlave parent_obj;
+    uint16_t ptr;
+    int nsent;
+    bool fresh;
+    bool down, home;
+    uint32_t x, y;
+};
+
+static uint8_t gt911_reg(GT911State *s, uint16_t reg)
+{
+    if (reg == GT911_STATUS) {
+        return s->fresh ? 0x80 | (s->home ? 0x10 : 0) | (s->down ? 1 : 0) : 0;
+    }
+    /* coordinates at byte 0 of the record, as on the X4 Pro */
+    switch (reg - GT911_POINTS) {
+    case 0: return s->x;
+    case 1: return s->x >> 8;
+    case 2: return s->y;
+    case 3: return s->y >> 8;
+    case 4: return 0x20;  /* contact size */
+    }
+    if (reg >= 0x8140 && reg < 0x8144) {
+        return "911"[reg - 0x8140];  /* product id */
+    }
+    return 0;
+}
+
+static int gt911_event(I2CSlave *i2c, enum i2c_event event)
+{
+    GT911State *s = GT911(i2c);
+    if (event == I2C_START_SEND) {
+        s->nsent = 0;
+    }
+    return 0;
+}
+
+static uint8_t gt911_recv(I2CSlave *i2c)
+{
+    GT911State *s = GT911(i2c);
+    return gt911_reg(s, s->ptr++);
+}
+
+static int gt911_send(I2CSlave *i2c, uint8_t data)
+{
+    GT911State *s = GT911(i2c);
+    if (s->nsent < 2) {
+        s->ptr = s->nsent ? (s->ptr & 0xFF00) | data : data << 8;
+    } else {
+        if (s->ptr == GT911_STATUS && data == 0) {
+            s->fresh = s->down || s->home;
+        }
+        s->ptr++;
+    }
+    s->nsent++;
+    return 0;
+}
+
+static void gt911_set_down(Object *obj, bool value, Error **errp)
+{
+    GT911State *s = GT911(obj);
+    s->down = value;
+    s->fresh = true;
+}
+
+static bool gt911_get_down(Object *obj, Error **errp)
+{
+    return GT911(obj)->down;
+}
+
+static void gt911_set_home(Object *obj, bool value, Error **errp)
+{
+    GT911State *s = GT911(obj);
+    s->home = value;
+    s->fresh = true;
+}
+
+static bool gt911_get_home(Object *obj, Error **errp)
+{
+    return GT911(obj)->home;
+}
+
+static void gt911_init(Object *obj)
+{
+    GT911State *s = GT911(obj);
+    object_property_add_bool(obj, "down", gt911_get_down, gt911_set_down);
+    object_property_add_bool(obj, "home", gt911_get_home, gt911_set_home);
+    object_property_add_uint32_ptr(obj, "x", &s->x, OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "y", &s->y, OBJ_PROP_FLAG_READWRITE);
+}
+
+static void gt911_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    k->event = gt911_event;
+    k->recv = gt911_recv;
+    k->send = gt911_send;
+}
+
+static const TypeInfo lector_i2c_types[] = {
+    {
+        .name = TYPE_I2C_REGS,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(I2CRegsState),
+        .class_init = i2c_regs_class_init,
+    },
+    {
+        .name = TYPE_GT911,
