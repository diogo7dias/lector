 static void esp32s3_rtc_update_cpu_stall(Esp32s3RtcCntlState* s);
 static void esp32s3_rtc_update_clk(Esp32s3RtcCntlState* s);
 
+/* lector simulator: sleep and wake. Offsets from the S3 rtc_cntl_reg.h. */
+#define A_SLP_TIMER0        0x004
+#define A_SLP_TIMER1        0x008
+#define A_STATE0            0x018
+#define A_WAKEUP_STATE      0x03C
+#define A_INT_RAW           0x044
+#define A_INT_CLR           0x04C
+#define A_EXT_WAKEUP_CONF   0x064
+#define A_DIG_PWC           0x090
+#define A_EXT_WAKEUP1       0x0E0
+#define A_EXT_WAKEUP1_STAT  0x0E4
+#define A_SLP_WAKEUP_CAUSE  0x130
+
+#define SLEEP_EN            BIT(31)
+#define DG_WRAP_PD_EN       BIT(31)
+#define SLP_WAKEUP_INT      BIT(0)
+#define EXT1_LV_HIGH        BIT(31)    /* EXT_WAKEUP_CONF: 1 = any pin high, 0 = any pin low */
+#define WAKE_EXT1           BIT(1)
+#define WAKE_GPIO           BIT(2)
+#define WAKE_TIMER          BIT(3)
+
+/* Count the RTC timer at the rate the firmware calibrated (STORE1: us per
+ * tick, Q13.19), so light-sleep time correction lands exactly. */
+static uint64_t rtc_ticks(Esp32s3RtcCntlState *s)
+{
+    const uint64_t ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->time_base_ns;
+    const uint32_t cal = s->scratch_reg[1];
+    if (cal == 0) {
+        return muldiv64(ns, s->rtc_slowclk_freq, NANOSECONDS_PER_SECOND);
+    }
+    return muldiv64(ns, 1ULL << 19, 1000ULL * cal);
+}
+
+/* EXT1: RTC IO n is GPIO n on the S3 for the pins lector uses (0-21). */
+static uint32_t ext1_status(Esp32s3RtcCntlState *s)
+{
+    const uint32_t mask = s->regs[A_EXT_WAKEUP1 / 4] & 0x3FFFFF;
+    const bool want_high = s->regs[A_EXT_WAKEUP_CONF / 4] & EXT1_LV_HIGH;
+    uint32_t status = 0;
+    for (int pin = 0; s->gpio && pin < 22; pin++) {
+        if ((mask & BIT(pin)) && esp32c3_gpio_level(s->gpio, pin) == want_high) {
+            status |= BIT(pin);
+        }
+    }
+    return status;
+}
+
+static uint32_t pending_wake(Esp32s3RtcCntlState *s)
+{
+    const uint32_t ena = s->regs[A_WAKEUP_STATE / 4] >> 15;
+    const uint64_t target = ((uint64_t)(s->regs[A_SLP_TIMER1 / 4] & 0xFFFF) << 32) | s->regs[A_SLP_TIMER0 / 4];
+    uint32_t cause = 0;
+    if ((ena & WAKE_EXT1) && ext1_status(s)) {
+        cause |= WAKE_EXT1;
+    }
+    if ((ena & WAKE_TIMER) && rtc_ticks(s) >= target) {
+        cause |= WAKE_TIMER;
+    }
+    return cause;
+}
+
+/* Deep sleep: the cores spin after SLEEP_EN, standing in for power-down,
+ * until a wake source fires; then the chip boots with reason DEEPSLEEP. */
+static void esp32s3_wake_check(void *opaque)
+{
+    Esp32s3RtcCntlState *s = opaque;
+    if (!s->deep_sleeping) {
+        return;
+    }
+    const uint32_t cause = pending_wake(s);
+    if (!cause) {
+        timer_mod(s->wake_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 5);
+        return;
+    }
+    s->deep_sleeping = false;
+    s->regs[A_SLP_WAKEUP_CAUSE / 4] = cause;
+    s->regs[A_EXT_WAKEUP1_STAT / 4] = ext1_status(s);
+    s->reset_cause[0] = ESP32_DEEPSLEEP_RESET;
+    s->reset_cause[1] = ESP32_DEEPSLEEP_RESET;
+    qemu_irq_pulse(s->dig_reset_req);
+}
+
+static void esp32s3_sleep_start(Esp32s3RtcCntlState *s)
+{
+    if (s->regs[A_DIG_PWC / 4] & DG_WRAP_PD_EN) {
+        s->deep_sleeping = true;
+        esp32s3_wake_check(s);
+        return;
+    }
