diff --git a/hw/misc/esp32s3_sens.c b/hw/misc/esp32s3_sens.c
new file mode 100644
index 0000000..dfc1cb6
--- /dev/null
+++ b/hw/misc/esp32s3_sens.c
@@ -0,0 +1,79 @@
+/*
+ * ESP32-S3 SENS block, one-shot SAR ADC only, for the lector simulator.
+ *
+ * A conversion started through SAR_MEAS{1,2}_CTRL2 completes at once with the
+ * raw reading from the "adc1"/"adc2" properties. The X4 Pro reads no analog
+ * input of its own; the ADC is touched only by the driver's self-calibration.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "hw/sysbus.h"
+
+#define TYPE_ESP32S3_SENS "esp32s3.sens"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3SensState, ESP32S3_SENS)
+
+#define A_MEAS1_CTRL2   0x00C
+#define A_MEAS2_CTRL2   0x030
+#define A_SLAVE_ADDR1   0x040
+#define START           BIT(17)
+#define DONE            BIT(16)
+
+struct ESP32S3SensState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t regs[0x400 / 4];
+    uint32_t raw[2];
+};
+
+static uint64_t esp32s3_sens_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32S3SensState *s = ESP32S3_SENS(opaque);
+    /* meas_status: the controller is never busy between conversions. */
+    return addr == A_SLAVE_ADDR1 ? 0 : s->regs[addr / 4];
+}
+
+static void esp32s3_sens_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ESP32S3SensState *s = ESP32S3_SENS(opaque);
+    if (addr == A_MEAS1_CTRL2 || addr == A_MEAS2_CTRL2) {
+        const int unit = addr == A_MEAS2_CTRL2;
+        value &= ~(DONE | 0xFFFF);
+        if (value & START) {
+            value |= DONE | (s->raw[unit] & 0xFFF);
+        }
+    }
+    s->regs[addr / 4] = value;
+}
+
+static const MemoryRegionOps esp32s3_sens_ops = {
+    .read = esp32s3_sens_read,
+    .write = esp32s3_sens_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void esp32s3_sens_init(Object *obj)
+{
+    ESP32S3SensState *s = ESP32S3_SENS(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32s3_sens_ops, s, TYPE_ESP32S3_SENS, 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->raw[0] = s->raw[1] = 2048;
+    object_property_add_uint32_ptr(obj, "adc1", &s->raw[0], OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "adc2", &s->raw[1], OBJ_PROP_FLAG_READWRITE);
+}
+
+static const TypeInfo esp32s3_sens_info = {
+    .name = TYPE_ESP32S3_SENS,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3SensState),
+    .instance_init = esp32s3_sens_init,
+};
+
+static void esp32s3_sens_register_types(void)
+{
+    type_register_static(&esp32s3_sens_info);
+}
+
+type_init(esp32s3_sens_register_types)
