diff --git a/hw/display/ssd1677.c b/hw/display/ssd1677.c
new file mode 100644
index 0000000..905196c
--- /dev/null
+++ b/hw/display/ssd1677.c
@@ -0,0 +1,303 @@
+/*
+ * SSD1677 e-paper controller (800x480, as on the Xteink X4), for the lector
+ * simulator.
+ *
+ * Commands arrive on SPI with D/C low, parameters and pixel data with D/C
+ * high. The model keeps both RAM planes (0x24 black/white, 0x26 "red"),
+ * honours the RAM window, address counters and data-entry mode, and on a
+ * display update (0x22 + 0x20) raises BUSY for the length of the waveform,
+ * then shows the black/white plane: it writes the visible frame as a PGM to
+ * the "image" path and counts it in "frames".
+ *
+ * Not modelled: waveforms, ghosting and the look of partial updates. A
+ * grayscale update shows the two planes combined as four grays.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/ssi.h"
+#include "qapi/visitor.h"
+
+#define TYPE_SSD1677 "ssd1677"
+OBJECT_DECLARE_SIMPLE_TYPE(Ssd1677State, SSD1677)
+
+#define W 800
+#define H 480
+#define ROW (W / 8)
+
+struct Ssd1677State {
+    SSIPeripheral parent_obj;
+    qemu_irq busy;
+    QEMUTimer *busy_timer;
+
+    bool dc;
+    bool asleep;
+    uint8_t cmd;
+    uint32_t nparam;
+    uint8_t params[16];
+
+    uint8_t entry;
+    int xs, xe, ys, ye;
+    int x, y;
+    uint8_t seq;            /* 0x22 parameter */
+    bool lut_loaded;        /* a custom waveform (0x32) since reset: grayscale */
+    bool update_shows;      /* the pending update changes the image */
+
+    uint8_t bw[H][ROW];
+    uint8_t red[H][ROW];
+    uint8_t screen[H][W];   /* what the panel shows: 0 black .. 255 white */
+
+    char *image;            /* where each shown frame is written (PGM) */
+    uint32_t frames;
+    uint32_t busy_full_ms, busy_half_ms, busy_fast_ms;
+};
+
+static void ssd1677_reset_state(Ssd1677State *s)
+{
+    s->asleep = false;
+    s->cmd = 0;
+    s->nparam = 0;
+    s->entry = 0x03;
+    s->xs = 0; s->xe = W - 1;
+    s->ys = 0; s->ye = H - 1;
+    s->x = 0; s->y = 0;
+    s->seq = 0xFF;
+    s->lut_loaded = false;
+    timer_del(s->busy_timer);
+    qemu_set_irq(s->busy, 0);
+}
+
+static void ssd1677_write_image(Ssd1677State *s)
+{
+    if (!s->image) {
+        return;
+    }
+    g_autofree char *tmp = g_strdup_printf("%s.tmp", s->image);
+    FILE *f = fopen(tmp, "wb");
+    if (!f) {
+        return;
+    }
+    fprintf(f, "P5\n%d %d\n255\n", W, H);
+    fwrite(s->screen, 1, sizeof(s->screen), f);
+    fclose(f);
+    rename(tmp, s->image);
+}
+
+/* The waveform finished: the panel now shows the RAM. */
+static void ssd1677_update_done(void *opaque)
+{
+    Ssd1677State *s = opaque;
+    if (s->update_shows) {
+        const bool gray = s->lut_loaded;
+        for (int y = 0; y < H; y++) {
+            for (int x = 0; x < W; x++) {
+                const int bit = 7 - (x & 7);
+                const int b = (s->bw[y][x / 8] >> bit) & 1;
+                if (gray) {
+                    const int r = (s->red[y][x / 8] >> bit) & 1;
+                    static const uint8_t level[4] = { 0x00, 0x55, 0xAA, 0xFF };
+                    s->screen[y][x] = level[(b << 1) | r];
+                } else {
+                    s->screen[y][x] = b ? 0xFF : 0x00;
+                }
+            }
+        }
+        s->frames++;
+        ssd1677_write_image(s);
+    }
+    qemu_set_irq(s->busy, 0);
+}
+
+static void ssd1677_busy_for(Ssd1677State *s, uint32_t ms)
+{
+    qemu_set_irq(s->busy, 1);
+    timer_mod(s->busy_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + ms);
+}
+
+static void ssd1677_activate(Ssd1677State *s)
+{
+    /* 0x22 bits: 0x04 runs the display waveform; 0x08 with it picks mode 2. */
+    s->update_shows = s->seq & 0x04;
+    uint32_t ms = 50;
+    if (s->update_shows) {
+        switch (s->seq) {
+        case 0xF7: case 0xC7: ms = s->busy_full_ms; break;
+        case 0xD7:            ms = s->busy_half_ms; break;
+        default:              ms = s->busy_fast_ms; break;
+        }
+    }
+    ssd1677_busy_for(s, ms);
+}
+
+static void ssd1677_ram_write(Ssd1677State *s, uint8_t plane[H][ROW], uint8_t value)
+{
+    if (s->x >= 0 && s->x < W && s->y >= 0 && s->y < H) {
+        plane[s->y][s->x / 8] = value;
+    }
+    /* Step X; past the window's far edge, wrap X and step Y the same way. */
+    const bool x_inc = s->entry & 0x01, y_inc = s->entry & 0x02;
+    s->x += x_inc ? 8 : -8;
+    if (x_inc ? s->x > s->xe : s->x < s->xe) {
+        s->x = s->xs;
+        s->y += y_inc ? 1 : -1;
+        if (y_inc ? s->y > s->ye : s->y < s->ye) {
+            s->y = s->ys;
+        }
+    }
+}
+
+static void ssd1677_param(Ssd1677State *s, uint8_t v)
+{
+    const uint32_t n = s->nparam++;
+    if (n < sizeof(s->params)) {
+        s->params[n] = v;
+    }
+    const uint8_t *p = s->params;
+    switch (s->cmd) {
+    case 0x11:
+        s->entry = v;
+        break;
+    case 0x44:
+        if (n == 1) s->xs = p[0] | (p[1] << 8);
+        if (n == 3) s->xe = p[2] | (p[3] << 8);
+        break;
+    case 0x45:
+        if (n == 1) s->ys = p[0] | (p[1] << 8);
+        if (n == 3) s->ye = p[2] | (p[3] << 8);
+        break;
+    case 0x4E:
+        if (n == 1) s->x = p[0] | (p[1] << 8);
+        break;
+    case 0x4F:
+        if (n == 1) s->y = p[0] | (p[1] << 8);
+        break;
+    case 0x22:
+        s->seq = v;
+        break;
+    case 0x24:
+        ssd1677_ram_write(s, s->bw, v);
+        break;
+    case 0x26:
+        ssd1677_ram_write(s, s->red, v);
+        break;
+    case 0x32:
+        s->lut_loaded = true;
+        break;
+    case 0x46:
+    case 0x47:
+        /* Auto-fill with a regular pattern; lector only ever fills solid. */
+        memset(s->cmd == 0x46 ? (void *)s->red : (void *)s->bw, (v & 0x80) ? 0xFF : 0x00, sizeof(s->bw));
+        ssd1677_busy_for(s, 10);
+        break;
+    case 0x10:
+        if (v & 0x03) {
+            s->asleep = true;
+        }
+        break;
+    }
+}
+
+static void ssd1677_command(Ssd1677State *s, uint8_t c)
+{
+    s->cmd = c;
+    s->nparam = 0;
+    switch (c) {
+    case 0x12:
+        ssd1677_reset_state(s);
+        s->cmd = c;
+        ssd1677_busy_for(s, 2);
+        break;
+    case 0x20:
+        ssd1677_activate(s);
+        break;
+    }
+}
+
+static uint32_t ssd1677_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    Ssd1677State *s = SSD1677(dev);
+    if (s->asleep) {
+        return 0;
+    }
+    if (s->dc) {
+        ssd1677_param(s, val);
+    } else {
+        ssd1677_command(s, val);
+    }
+    return 0;
+}
+
+static void ssd1677_dc(void *opaque, int n, int level)
+{
+    SSD1677(opaque)->dc = level;
+}
+
+static void ssd1677_rst(void *opaque, int n, int level)
+{
+    Ssd1677State *s = SSD1677(opaque);
+    if (!level) {
+        /* Reset keeps the RAM, like the chip; only the registers start over. */
+        ssd1677_reset_state(s);
+    }
+}
+
+static void ssd1677_realize(SSIPeripheral *dev, Error **errp)
+{
+    Ssd1677State *s = SSD1677(dev);
+    s->busy_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, ssd1677_update_done, s);
+    qdev_init_gpio_in_named(DEVICE(dev), ssd1677_dc, "dc", 1);
+    qdev_init_gpio_in_named(DEVICE(dev), ssd1677_rst, "rst", 1);
+    qdev_init_gpio_out_named(DEVICE(dev), &s->busy, "busy", 1);
+    memset(s->bw, 0xFF, sizeof(s->bw));
+    memset(s->red, 0xFF, sizeof(s->red));
+    memset(s->screen, 0xFF, sizeof(s->screen));
+    ssd1677_reset_state(s);
+}
+
+static Property ssd1677_properties[] = {
+    DEFINE_PROP_STRING("image", Ssd1677State, image),
+    /* Waveform lengths, roughly what the X4 panel takes. */
+    DEFINE_PROP_UINT32("busy-full-ms", Ssd1677State, busy_full_ms, 1600),
+    DEFINE_PROP_UINT32("busy-half-ms", Ssd1677State, busy_half_ms, 900),
+    DEFINE_PROP_UINT32("busy-fast-ms", Ssd1677State, busy_fast_ms, 400),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void ssd1677_frames_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &SSD1677(obj)->frames, errp);
+}
+
+static void ssd1677_init(Object *obj)
+{
+    object_property_add(obj, "frames", "uint32", ssd1677_frames_get, NULL, NULL, NULL);
+}
+
+static void ssd1677_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+    k->realize = ssd1677_realize;
+    k->transfer = ssd1677_transfer;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_props(dc, ssd1677_properties);
+}
+
+static const TypeInfo ssd1677_info = {
+    .name = TYPE_SSD1677,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(Ssd1677State),
+    .instance_init = ssd1677_init,
+    .class_init = ssd1677_class_init,
+};
+
+static void ssd1677_register_types(void)
+{
+    type_register_static(&ssd1677_info);
+}
+
+type_init(ssd1677_register_types)
diff --git a/hw/gpio/esp32c3_gpio.c b/hw/gpio/esp32c3_gpio.c
index 1e84238..8492789 100644
--- a/hw/gpio/esp32c3_gpio.c
+++ b/hw/gpio/esp32c3_gpio.c
@@ -1,5 +1,7 @@
 /*
- * ESP32-C3 GPIO emulation
+ * ESP32-C3 GPIO, extended for the lector simulator: the output, enable, input
+ * and interrupt registers behave like the chip's. The GPIO matrix routing is
+ * not modelled: a pin's output is GPIO_OUT whatever peripheral owns it.
  *
  * Copyright (c) 2023 Espressif Systems (Shanghai) Co. Ltd.
  *
@@ -12,6 +14,7 @@
 #include "qemu/log.h"
 #include "qemu/error-report.h"
 #include "qapi/error.h"
+#include "qapi/visitor.h"
 #include "hw/hw.h"
 #include "hw/sysbus.h"
 #include "hw/registerfields.h"
@@ -19,11 +22,186 @@
 #include "hw/qdev-properties.h"
 #include "hw/gpio/esp32c3_gpio.h"
 
+#define A_OUT          0x04
+#define A_OUT_W1TS     0x08
+#define A_OUT_W1TC     0x0C
+#define A_ENABLE       0x20
+#define A_ENABLE_W1TS  0x24
+#define A_ENABLE_W1TC  0x28
+#define A_STRAP        0x38
+#define A_IN           0x3C
+#define A_STATUS       0x44
+#define A_STATUS_W1TS  0x48
+#define A_STATUS_W1TC  0x4C
+#define A_PCPU_INT     0x5C
+#define A_PIN0         0x74
+#define A_DATE         0x6FC
+
+#define PIN_INT_TYPE(v) (((v) >> 7) & 0x7)
+#define PIN_INT_ENA(v)  (((v) >> 13) & 0x1F)
+
+#define PIN_MASK ((1u << ESP32C3_GPIO_COUNT) - 1)
+
+static uint32_t esp32c3_gpio_in(ESP32C3GPIOState *s)
+{
+    uint32_t ext = (s->levels & ~s->driven_mask) | (s->driven_levels & s->driven_mask);
+    return ((ext & ~s->enable) | (s->out & s->enable)) & PIN_MASK;
+}
+
+bool esp32c3_gpio_level(ESP32C3GPIOState *s, int pin)
+{
+    return (esp32c3_gpio_in(s) >> pin) & 1;
+}
+
+static void esp32c3_gpio_update_irq(ESP32C3GPIOState *s)
+{
+    uint32_t pending = 0;
+    for (int i = 0; i < ESP32C3_GPIO_COUNT; i++) {
+        if ((s->status & BIT(i)) && PIN_INT_ENA(s->pin[i])) {
+            pending |= BIT(i);
+        }
+    }
+    qemu_set_irq(s->parent.irq, pending != 0);
+}
+
+/* Latch edge and level interrupts after any change to what the pins read. */
+static void esp32c3_gpio_sample(ESP32C3GPIOState *s)
+{
+    const uint32_t in = esp32c3_gpio_in(s);
+    const uint32_t rose = in & ~s->last_in, fell = ~in & s->last_in;
+    for (int i = 0; i < ESP32C3_GPIO_COUNT; i++) {
+        bool hit = false;
+        switch (PIN_INT_TYPE(s->pin[i])) {
+        case 1: hit = rose & BIT(i); break;
+        case 2: hit = fell & BIT(i); break;
+        case 3: hit = (rose | fell) & BIT(i); break;
+        case 4: hit = !(in & BIT(i)); break;
+        case 5: hit = in & BIT(i); break;
+        }
+        if (hit) {
+            s->status |= BIT(i);
+        }
+    }
+    s->last_in = in;
+    esp32c3_gpio_update_irq(s);
+}
+
+static void esp32c3_gpio_drive_outputs(ESP32C3GPIOState *s, uint32_t old_out, uint32_t old_en)
+{
+    for (int i = 0; i < ESP32C3_GPIO_COUNT; i++) {
+        const bool was = (old_en & BIT(i)) && (old_out & BIT(i));
+        const bool now = (s->enable & BIT(i)) && (s->out & BIT(i));
+        const bool en_changed = (old_en ^ s->enable) & BIT(i);
+        if (was != now || en_changed) {
+            /* A pin that stops driving reads its external level, like the real pad. */
+            qemu_set_irq(s->pin_out[i], (s->enable & BIT(i)) ? now : esp32c3_gpio_level(s, i));
+        }
+    }
+    esp32c3_gpio_sample(s);
+}
+
+static uint64_t esp32c3_gpio_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32C3GPIOState *s = ESP32C3_GPIO(opaque);
+    switch (addr) {
+    case A_OUT:      return s->out;
+    case A_ENABLE:   return s->enable;
+    case A_STRAP:    return s->parent.strap_mode;
+    case A_IN:       return esp32c3_gpio_in(s);
+    case A_STATUS:   return s->status;
+    case A_PCPU_INT: {
+        uint32_t r = 0;
+        for (int i = 0; i < ESP32C3_GPIO_COUNT; i++) {
+            if ((s->status & BIT(i)) && PIN_INT_ENA(s->pin[i])) {
+                r |= BIT(i);
+            }
+        }
+        return r;
+    }
+    case A_DATE:     return 0x2006130;
+    }
+    if (addr >= A_PIN0 && addr < A_PIN0 + 4 * ESP32C3_GPIO_COUNT) {
+        return s->pin[(addr - A_PIN0) / 4];
+    }
+    return 0;
+}
+
+static void esp32c3_gpio_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    ESP32C3GPIOState *s = ESP32C3_GPIO(opaque);
+    const uint32_t old_out = s->out, old_en = s->enable;
+    switch (addr) {
+    case A_OUT:         s->out = value & PIN_MASK; break;
+    case A_OUT_W1TS:    s->out |= value & PIN_MASK; break;
+    case A_OUT_W1TC:    s->out &= ~value; break;
+    case A_ENABLE:      s->enable = value & PIN_MASK; break;
+    case A_ENABLE_W1TS: s->enable |= value & PIN_MASK; break;
+    case A_ENABLE_W1TC: s->enable &= ~value; break;
+    case A_STATUS:      s->status = value & PIN_MASK; esp32c3_gpio_update_irq(s); return;
+    case A_STATUS_W1TS: s->status |= value & PIN_MASK; esp32c3_gpio_update_irq(s); return;
+    case A_STATUS_W1TC:
+        s->status &= ~value;
+        /* Level interrupts re-assert while the level holds. */
+        esp32c3_gpio_sample(s);
+        return;
+    default:
+        if (addr >= A_PIN0 && addr < A_PIN0 + 4 * ESP32C3_GPIO_COUNT) {
+            s->pin[(addr - A_PIN0) / 4] = value;
+            esp32c3_gpio_sample(s);
+        }
+        return;
+    }
+    esp32c3_gpio_drive_outputs(s, old_out, old_en);
+}
+
+static const MemoryRegionOps esp32c3_gpio_ops = {
+    .read =  esp32c3_gpio_read,
+    .write = esp32c3_gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32c3_gpio_pin_in(void *opaque, int n, int level)
+{
+    ESP32C3GPIOState *s = ESP32C3_GPIO(opaque);
+    s->driven_mask |= BIT(n);
+    s->driven_levels = level ? (s->driven_levels | BIT(n)) : (s->driven_levels & ~BIT(n));
+    esp32c3_gpio_sample(s);
+}
+
+static void esp32c3_gpio_levels_set(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    ESP32C3GPIOState *s = ESP32C3_GPIO(obj);
+    uint32_t value;
+    if (visit_type_uint32(v, name, &value, errp)) {
+        s->levels = value;
+        esp32c3_gpio_sample(s);
+    }
+}
+
+static void esp32c3_gpio_levels_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    ESP32C3GPIOState *s = ESP32C3_GPIO(obj);
+    uint32_t value = esp32c3_gpio_in(s);
+    visit_type_uint32(v, name, &value, errp);
+}
 
 static void esp32c3_gpio_init(Object *obj)
 {
+    ESP32C3GPIOState *s = ESP32C3_GPIO(obj);
     /* Set the default value for the property */
     object_property_set_int(obj, "strap_mode", ESP32C3_STRAP_MODE_FLASH_BOOT, &error_fatal);
+
+    /* Replace the generic ESP32 register block with this one. */
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32c3_gpio_ops, s, TYPE_ESP32C3_GPIO, 0x1000);
+    sbd->mmio[0].memory = &s->iomem;
+
+    /* Floating pins read high: every input lector reads has a pull-up. */
+    s->levels = PIN_MASK;
+    s->last_in = PIN_MASK;
+    object_property_add(obj, "levels", "uint32", esp32c3_gpio_levels_get, esp32c3_gpio_levels_set, NULL, NULL);
+    qdev_init_gpio_in_named(DEVICE(obj), esp32c3_gpio_pin_in, "pin-in", ESP32C3_GPIO_COUNT);
+    qdev_init_gpio_out_named(DEVICE(obj), s->pin_out, "pin-out", ESP32C3_GPIO_COUNT);
 }
 
 /* If we need to override any function from the parent (reset, realize, ...), it shall be done
diff --git a/hw/misc/esp32c3_jtag.c b/hw/misc/esp32c3_jtag.c
index 82ee697..5a426b9 100644
--- a/hw/misc/esp32c3_jtag.c
+++ b/hw/misc/esp32c3_jtag.c
@@ -14,19 +14,76 @@
 #include "hw/hw.h"
