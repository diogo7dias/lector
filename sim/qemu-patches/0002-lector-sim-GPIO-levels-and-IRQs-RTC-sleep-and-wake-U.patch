@@ -0,0 +1,20 @@
+/*
+ * ESP32-C3 general-purpose SPI master (SPI2), for the lector simulator.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "hw/ssi/ssi.h"
+#include "hw/dma/esp_gdma.h"
+
+#define TYPE_ESP32C3_GPSPI "esp32c3.gpspi"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32C3GpspiState, ESP32C3_GPSPI)
+
+struct ESP32C3GpspiState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    SSIBus *spi;
+    ESPGdmaState *gdma;
+    uint32_t regs[0x100 / 4];
+};
