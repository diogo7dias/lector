+/* RTC slow clock as the sleep timer counts it. Only consistency with the
+ * firmware matters: it converts ticks to time with the calibration it stored
+ * in STORE1 (microseconds per tick, Q13.19), so count at exactly that rate.
+ * Any other rate makes light-sleep time correction overshoot. */
+#define RTC_SLOW_HZ 150000ULL
+#define WAKE_CAUSE_GPIO  BIT(2)
+#define WAKE_CAUSE_TIMER BIT(3)
+
+static uint64_t rtc_ticks(ESP32C3RtcCntlState *s)
+{
+    const uint64_t ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    const uint32_t cal = s->scratch_reg[1];
+    if (cal == 0) {
+        return muldiv64(ns, RTC_SLOW_HZ, NANOSECONDS_PER_SECOND);
+    }
+    return muldiv64(ns, 1ULL << 19, 1000ULL * cal);
+}
+
+/* Which enabled RTC GPIO (0-5) is at its wake level, as a status bitmask. */
+static uint32_t gpio_wake_status(ESP32C3RtcCntlState *s)
+{
+    const uint32_t conf = s->regs[A_RTC_CNTL_RTC_CNTL_GPIO_WAKEUP / 4];
+    uint32_t status = 0;
+    if (!s->gpio) {
+        return 0;
+    }
+    for (int pin = 0; pin < 6; pin++) {
+        if (!(conf & BIT(31 - pin))) {
+            continue;
+        }
+        const unsigned type = (conf >> (23 - 3 * pin)) & 0x7;
+        const bool level = esp32c3_gpio_level(s->gpio, pin);
+        if ((type == 4 && !level) || (type == 5 && level)) {
+            status |= BIT(pin);
+        }
+    }
+    return status;
+}
+
+static bool timer_due(ESP32C3RtcCntlState *s)
+{
+    const uint64_t target = ((uint64_t)(s->regs[A_RTC_CNTL_RTC_SLP_TIMER1 / 4] & 0xFFFF) << 32)
+                            | s->regs[A_RTC_CNTL_RTC_SLP_TIMER0 / 4];
+    return rtc_ticks(s) >= target;
+}
+
+static uint32_t pending_wake(ESP32C3RtcCntlState *s)
+{
+    const uint32_t ena = s->regs[A_RTC_CNTL_RTC_WAKEUP_STATE / 4] >> 15;
+    uint32_t cause = 0;
+    if ((ena & WAKE_CAUSE_GPIO) && gpio_wake_status(s)) {
+        cause |= WAKE_CAUSE_GPIO;
+    }
+    if ((ena & WAKE_CAUSE_TIMER) && timer_due(s)) {
+        cause |= WAKE_CAUSE_TIMER;
+    }
+    return cause;
+}
+
+/* Deep sleep: the core is off until a wake source fires, then the chip boots
