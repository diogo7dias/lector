+/*
+ * Pin levels for the lector simulator. "levels" is what the outside world
+ * drives onto each input pin (a test sets it with qom-set); a device model can
+ * drive a pin instead through the named "pin-in" GPIO lines, which take
+ * precedence while asserted. Output pins are mirrored on the "pin-out" lines.
+ */
 typedef struct ESP32C3State {
     Esp32GpioState parent;
+    MemoryRegion iomem;
+    uint32_t out;
+    uint32_t enable;
+    uint32_t status;
+    uint32_t pin[ESP32C3_GPIO_COUNT];
+    uint32_t levels;        /* external levels, settable at run time */
