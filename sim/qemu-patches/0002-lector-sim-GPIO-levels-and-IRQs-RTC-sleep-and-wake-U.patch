diff --git a/hw/ssi/esp32c3_gpspi.c b/hw/ssi/esp32c3_gpspi.c
new file mode 100644
index 0000000..8e43f28
--- /dev/null
+++ b/hw/ssi/esp32c3_gpspi.c
@@ -0,0 +1,220 @@
+/*
+ * ESP32-C3 general-purpose SPI master (SPI2), for the lector simulator.
+ *
+ * A user transaction runs to completion the moment CMD.USR is set: the
+ * command, address and data phases are clocked out byte by byte on the SSI
+ * bus, MISO bytes land in W0..W15 (or go out through GDMA when DMA is on).
+ * Chip selects are whatever GPIOs the devices on the bus listen to; the
+ * controller's own CS lines are not modelled because lector drives CS by GPIO.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/log.h"
+#include "hw/irq.h"
+#include "hw/ssi/esp32c3_gpspi.h"
+
+#define A_CMD          0x00
+#define A_ADDR         0x04
+#define A_CTRL         0x08
+#define A_USER         0x10
+#define A_USER1        0x14
+#define A_USER2        0x18
+#define A_MS_DLEN      0x1C
+#define A_DMA_CONF     0x30
+#define A_DMA_INT_ENA  0x34
+#define A_DMA_INT_CLR  0x38
+#define A_DMA_INT_RAW  0x3C
+#define A_DMA_INT_ST   0x40
+#define A_W0           0x98
+#define A_DATE         0xF0
+
+#define CMD_UPDATE     BIT(23)
+#define CMD_USR        BIT(24)
+
+#define USER_DOUTDIN   BIT(0)
+#define USER_MOSI_HIGH BIT(25)
+#define USER_MISO_HIGH BIT(24)
+#define USER_MOSI      BIT(27)
+#define USER_MISO      BIT(28)
+#define USER_DUMMY     BIT(29)
+#define USER_ADDR      BIT(30)
+#define USER_COMMAND   BIT(31)
+
+#define CTRL_WR_BIT_ORDER BIT(26)
+#define CTRL_RD_BIT_ORDER BIT(25)
+
+#define DMA_RX_ENA     BIT(27)
+#define DMA_TX_ENA     BIT(28)
+#define INT_TRANS_DONE BIT(12)
+
+#define BUF_BYTES 64
+
+static inline uint32_t reg(ESP32C3GpspiState *s, hwaddr a)
+{
+    return s->regs[a / 4];
+}
+
+static void esp32c3_gpspi_update_irq(ESP32C3GpspiState *s)
+{
+    qemu_set_irq(s->irq, (reg(s, A_DMA_INT_RAW) & reg(s, A_DMA_INT_ENA)) != 0);
+}
+
+static uint8_t bitrev8(uint8_t b)
+{
+    b = (b & 0xF0) >> 4 | (b & 0x0F) << 4;
+    b = (b & 0xCC) >> 2 | (b & 0x33) << 2;
+    return (b & 0xAA) >> 1 | (b & 0x55) << 1;
+}
+
+static void esp32c3_gpspi_transaction(ESP32C3GpspiState *s)
+{
+    const uint32_t user = reg(s, A_USER);
+    const bool lsb_out = reg(s, A_CTRL) & CTRL_WR_BIT_ORDER;
+    const bool lsb_in = reg(s, A_CTRL) & CTRL_RD_BIT_ORDER;
+
+    if (user & USER_COMMAND) {
+        const uint32_t user2 = reg(s, A_USER2);
+        const int bits = ((user2 >> 28) & 0xF) + 1;
+        const uint16_t value = user2 & 0xFFFF;
+        /* The command goes out low byte first, MSB first within each byte. */
+        for (int i = 0; i < (bits + 7) / 8; i++) {
+            ssi_transfer(s->spi, (value >> (8 * i)) & 0xFF);
+        }
+    }
+    if (user & USER_ADDR) {
+        const int bits = ((reg(s, A_USER1) >> 27) & 0x1F) + 1;
+        const uint32_t addr = reg(s, A_ADDR);
+        for (int i = (bits + 7) / 8 - 1; i >= 0; i--) {
+            ssi_transfer(s->spi, (addr >> (8 * i)) & 0xFF);
+        }
+    }
+    if (user & USER_DUMMY) {
+        const int cycles = (reg(s, A_USER1) & 0xFF) + 1;
+        for (int i = 0; i < (cycles + 7) / 8; i++) {
+            ssi_transfer(s->spi, 0xFF);
+        }
+    }
+
+    const bool mosi = user & USER_MOSI, miso = user & USER_MISO;
+    if (mosi || miso) {
+        const uint32_t len = (reg(s, A_MS_DLEN) & 0x3FFFF) / 8 + 1;
+        const bool dma_tx = mosi && (reg(s, A_DMA_CONF) & DMA_TX_ENA);
+        const bool dma_rx = miso && (reg(s, A_DMA_CONF) & DMA_RX_ENA);
+        g_autofree uint8_t *buf = g_malloc0(MAX(len, BUF_BYTES));
+        uint32_t tx_chan = 0, rx_chan = 0;
+
+        if (dma_tx) {
+            if (!s->gdma || !esp_gdma_get_channel_periph(s->gdma, GDMA_SPI2, ESP_GDMA_OUT_IDX, &tx_chan)
+                || !esp_gdma_read_channel(s->gdma, tx_chan, buf, len)) {
+                qemu_log_mask(LOG_GUEST_ERROR, "esp32c3_gpspi: TX DMA not ready\n");
+            }
+        } else if (mosi) {
+            /* CPU mode: W0..W7 or, with the high-part bit, W8..W15. */
+            const unsigned base = (user & USER_MOSI_HIGH) ? 32 : 0;
+            memcpy(buf, (uint8_t *)&s->regs[A_W0 / 4] + base, MIN(len, BUF_BYTES - base));
+        } else {
+            memset(buf, 0xFF, len);
+        }
+
+        for (uint32_t i = 0; i < len; i++) {
+            const uint8_t out = lsb_out ? bitrev8(buf[i]) : buf[i];
+            const uint8_t in = ssi_transfer(s->spi, out);
+            buf[i] = lsb_in ? bitrev8(in) : in;
+        }
+
+        if (dma_rx) {
+            if (!s->gdma || !esp_gdma_get_channel_periph(s->gdma, GDMA_SPI2, ESP_GDMA_IN_IDX, &rx_chan)
+                || !esp_gdma_write_channel(s->gdma, rx_chan, buf, len)) {
+                qemu_log_mask(LOG_GUEST_ERROR, "esp32c3_gpspi: RX DMA not ready\n");
+            }
+        } else if (miso) {
+            const unsigned base = (user & USER_MISO_HIGH) ? 32 : 0;
+            memcpy((uint8_t *)&s->regs[A_W0 / 4] + base, buf, MIN(len, BUF_BYTES - base));
+        }
+    }
+
+    s->regs[A_DMA_INT_RAW / 4] |= INT_TRANS_DONE;
+    esp32c3_gpspi_update_irq(s);
+}
+
+static uint64_t esp32c3_gpspi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32C3GpspiState *s = ESP32C3_GPSPI(opaque);
+    switch (addr) {
+    case A_DMA_INT_ST:
+        return reg(s, A_DMA_INT_RAW) & reg(s, A_DMA_INT_ENA);
+    case A_DATE:
+        return 0x2007220;
+    }
+    return reg(s, addr);
+}
+
+static void esp32c3_gpspi_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ESP32C3GpspiState *s = ESP32C3_GPSPI(opaque);
+    switch (addr) {
+    case A_CMD:
+        /* UPDATE (latch the config) and USR (run) both finish at once. */
+        s->regs[addr / 4] = value & ~(CMD_UPDATE | CMD_USR);
+        if (value & CMD_USR) {
+            esp32c3_gpspi_transaction(s);
+        }
+        return;
+    case A_DMA_INT_CLR:
+        s->regs[A_DMA_INT_RAW / 4] &= ~value;
+        esp32c3_gpspi_update_irq(s);
+        return;
+    case A_DMA_INT_ENA:
+        s->regs[addr / 4] = value;
+        esp32c3_gpspi_update_irq(s);
+        return;
+    case A_DMA_INT_RAW:
+    case A_DMA_INT_ST:
+        return;
+    }
+    s->regs[addr / 4] = value;
+}
+
+static const MemoryRegionOps esp32c3_gpspi_ops = {
+    .read = esp32c3_gpspi_read,
+    .write = esp32c3_gpspi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void esp32c3_gpspi_reset_hold(Object *obj, ResetType type)
+{
+    ESP32C3GpspiState *s = ESP32C3_GPSPI(obj);
+    memset(s->regs, 0, sizeof(s->regs));
+}
+
+static void esp32c3_gpspi_init(Object *obj)
+{
+    ESP32C3GpspiState *s = ESP32C3_GPSPI(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32c3_gpspi_ops, s, TYPE_ESP32C3_GPSPI, 0x100);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    s->spi = ssi_create_bus(DEVICE(s), "spi");
+}
+
+static void esp32c3_gpspi_class_init(ObjectClass *klass, void *data)
+{
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    rc->phases.hold = esp32c3_gpspi_reset_hold;
+}
+
+static const TypeInfo esp32c3_gpspi_info = {
+    .name = TYPE_ESP32C3_GPSPI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32C3GpspiState),
+    .instance_init = esp32c3_gpspi_init,
+    .class_init = esp32c3_gpspi_class_init,
+};
+
+static void esp32c3_gpspi_register_types(void)
+{
+    type_register_static(&esp32c3_gpspi_info);
+}
+
+type_init(esp32c3_gpspi_register_types)
