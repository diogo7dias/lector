+    const uint32_t cause = pending_wake(s);
+    s->regs[A_RTC_CNTL_RTC_SLP_WAKEUP_CAUSE / 4] = cause ? cause : WAKE_CAUSE_TIMER;
+    s->regs[A_RTC_CNTL_INT_RAW_RTC / 4] |= R_RTC_CNTL_INT_RAW_RTC_SLP_WAKEUP_INT_RAW_MASK;
+}
